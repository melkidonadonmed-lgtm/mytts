rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Personal user data: accessible only by the owner
    match /personalData/{appId}/users/{uid}/{collectionName}/{docId} {
      allow get: if uid == request.auth.uid;
      allow list: if uid == request.auth.uid && request.query.limit <= 100;
      allow write: if uid == request.auth.uid;
    }

    // Public app data: readable by all, limited queries
    match /publicData/{appId}/{collectionName}/{docId} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow write: if request.auth != null;
    }

    // Default rule for authenticated workspace operations
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}